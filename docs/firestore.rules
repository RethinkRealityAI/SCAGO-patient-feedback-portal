rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin (includes super-admin)
    function isAdmin() {
      return isAuthenticated() &&
             (request.auth.token.role == 'admin' || request.auth.token.role == 'super-admin');
    }
    
    // Helper function to check if user is super-admin (full access to all patient data)
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'super-admin';
    }
    
    // Helper function to check if user is YEP Manager
    function isYEPManager() {
      return isAuthenticated() &&
             request.auth.token.role == 'yep-manager';
    }
    
    // Helper function to check if user is admin or YEP Manager
    function isAdminOrYEPManager() {
      return isAdmin() || isYEPManager();
    }
    
    // Is this form on the signed-in admin's list in config/page_permissions?
    // That list is what the dashboard filters by; checking it here means the
    // database enforces it too, rather than only the UI.
    function formAllowed(surveyId) {
      let forms = get(/databases/$(database)/documents/config/page_permissions).data.formsByEmail;
      let email = request.auth.token.email;
      return email is string && email in forms && surveyId in forms[email];
    }

    // Super-admins see every form; other admins only the forms assigned to them.
    function canAccessForm(surveyId) {
      return isSuperAdmin() || (isAdmin() && formAllowed(surveyId));
    }

    // Surveys - Read by anyone, Write by admin only
    match /surveys/{surveyId} {
      allow read: if true;  // Anyone can view surveys
      allow create, update, delete: if isAdmin();  // Only admins can modify

      // Organized feedback submissions structure: surveys/{surveyId}/submissions/{submissionId}
      match /submissions/{submissionId} {
        // Public submissions go through the submitFeedback server action (Admin
        // SDK), which applies rate limiting and spam checks. Allowing direct
        // client writes here would let anyone bypass both.
        allow create: if false;
        allow read, update, delete: if canAccessForm(surveyId);
      }
    }

    // Legacy feedback submissions (pre-2025 hospital survey). Read-only archive:
    // nothing writes here any more, and the old public create rule let anyone
    // post straight into it.
    match /feedback/{feedbackId} {
      allow create: if false;
      allow read, update, delete: if isSuperAdmin() || (isAdmin() && formAllowed('QDl3z7vLa0IQ4JgHBZ2s'));
    }

    // Cross-form (collectionGroup) queries span every form's submissions, so
    // they are super-admin only. Restricted admins' dashboards fall back to
    // reading each permitted form individually.
    match /{path=**}/submissions/{submissionId} {
      allow read: if isSuperAdmin();
    }
    
    // Config collection - Read by authenticated users, Write by admin only
    match /config/{docId} {
      allow read: if isAuthenticated();  // Authenticated users can check admin status
      allow write: if isAdmin();  // Only admins can modify
    }
    
    // User tracking - Anyone can write (for login tracking), Admin can read
    match /users/{userId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();  // Users can update their own tracking data
    }
    
    // User activity - Anyone authenticated can write, Admin can read
    match /userActivity/{activityId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();  // For activity logging
    }
    
    // Backups collection - Admin only
    match /backups/{backupId} {
      allow read, write: if isAdmin();
    }
    
    // Youth Empowerment Program Collections - Admin, YEP Manager, or Owner
    match /yep_participants/{participantId} {
      // Admins and YEP Managers have full access
      allow read, write: if isAdminOrYEPManager();
      
      // Participants can read their own profile
      allow read: if isAuthenticated() && 
                     (resource.data.userId == request.auth.uid || 
                      resource.data.authEmail == request.auth.token.email);
      
      // Participants can update limited fields on their own profile
      allow update: if isAuthenticated() &&
                       (resource.data.userId == request.auth.uid ||
                        resource.data.authEmail == request.auth.token.email) &&
                       // Only allow updating specific fields (including all document upload fields)
                       request.resource.data.diff(resource.data).changedKeys()
                         .hasOnly(['phoneNumber', 'emergencyContactRelationship', 'emergencyContactNumber',
                                   'mailingAddress', 'streetAddress', 'city', 'province', 'postalCode',
                                   'availability', 'notes',
                                   // Simplified document storage
                                   'documents', 'additionalDocuments',
                                   // Legacy document fields (for backward compatibility)
                                   'fileUrl', 'fileName', 'fileType',
                                   'health_cardUrl', 'health_cardFileName', 'health_cardFileType',
                                   'photo_idUrl', 'photo_idFileName', 'photo_idFileType',
                                   'consent_formUrl', 'consent_formFileName', 'consent_formFileType',
                                   'idProvided', 'contractSigned',
                                   // System fields
                                   'lastLoginAt', 'profileCompleted', 'updatedAt']);
    }
    
    match /yep_mentors/{mentorId} {
      // Admins and YEP Managers have full access
      allow read, write: if isAdminOrYEPManager();
      
      // Mentors can read their own profile
      allow read: if isAuthenticated() && 
                     (resource.data.userId == request.auth.uid || 
                      resource.data.authEmail == request.auth.token.email);
      
      // Mentors can update limited fields on their own profile
      allow update: if isAuthenticated() &&
                       (resource.data.userId == request.auth.uid ||
                        resource.data.authEmail == request.auth.token.email) &&
                       // Only allow updating specific fields (including all document upload fields)
                       request.resource.data.diff(resource.data).changedKeys()
                         .hasOnly(['phone', 'availability',
                                   // Simplified document storage
                                   'documents', 'additionalDocuments',
                                   // Legacy document fields (for backward compatibility)
                                   'fileUrl', 'fileName', 'fileType',
                                   'police_checkUrl', 'police_checkFileName', 'police_checkFileType',
                                   'resumeUrl', 'resumeFileName', 'resumeFileType',
                                   'referencesUrl', 'referencesFileName', 'referencesFileType',
                                   'vulnerableSectorCheck', 'resumeProvided', 'referencesProvided',
                                   // System fields
                                   'lastLoginAt', 'profileCompleted', 'updatedAt']);
    }
    
    match /yep_workshops/{workshopId} {
      allow read, write: if isAdminOrYEPManager();
    }
    
    match /yep_workshop_attendance/{attendanceId} {
      allow read, write: if isAdminOrYEPManager();
    }
    
    match /yep_advisor_meetings/{meetingId} {
      allow read, write: if isAdminOrYEPManager();
    }
    
    // YEP Messages - Users can only read messages they sent or received
    match /yep_messages/{messageId} {
      // Users can only read messages they sent or received
      allow read: if isAuthenticated() && 
        (resource.data.senderId == request.auth.uid || 
         resource.data.recipientId == request.auth.uid);
      
      // Users can create messages if they are the sender
      allow create: if isAuthenticated() && 
        request.resource.data.senderId == request.auth.uid;
      
      // Users can update messages they received (mark as read)
      allow update: if isAuthenticated() && 
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['read', 'readAt', 'updatedAt']);
    }
    
    // YEP Meetings - Both participant and mentor can read their meetings
    match /yep_meetings/{meetingId} {
      // Both participant and mentor can read their meetings
      allow read: if isAuthenticated() && 
        (resource.data.participantUserId == request.auth.uid || 
         resource.data.mentorUserId == request.auth.uid);
      
      // Both can create meeting requests
      allow create: if isAuthenticated() && 
        (request.resource.data.participantUserId == request.auth.uid || 
         request.resource.data.mentorUserId == request.auth.uid);
      
      // Both can update meetings (approve, reject, cancel)
      allow update: if isAuthenticated() && 
        (resource.data.participantUserId == request.auth.uid || 
         resource.data.mentorUserId == request.auth.uid);
    }
    
    // YEP Form Templates - Admin or YEP Manager can write, authenticated users can read templates marked for participant profile
    match /yep-form-templates/{templateId} {
      // Admins and YEP Managers have full access
      allow read, write: if isAdminOrYEPManager();
      
      // Authenticated users can read templates marked for participant profile
      allow read: if isAuthenticated() && 
                     resource.data.showInParticipantProfile == true;
    }
    
    // YEP Form Submissions - Admin/YEP Manager full access, participants can read their own
    match /yep-form-submissions/{submissionId} {
      // Admins and YEP Managers have full access
      allow read, write: if isAdminOrYEPManager();
      
      // Participants can read their own submissions (by participantId and userId)
      allow read: if isAuthenticated() && 
                     resource.data.participantId != null &&
                     resource.data.submittedByUserId == request.auth.uid;
      
      // Mentors can read their own submissions
      allow read: if isAuthenticated() && 
                     resource.data.mentorId != null &&
                     resource.data.submittedByUserId == request.auth.uid;
      
      // Authenticated users can create submissions (must match their own userId)
      allow create: if isAuthenticated() && 
                       request.resource.data.submittedByUserId == request.auth.uid;
    }
    
    // Patient Management Collections - hardened boundary
    // Direct client SDK access is denied; patient access is server-only via Admin SDK
    // Region segmentation is enforced in server actions using config/page_permissions
    match /patients/{patientId} {
      allow read, write: if false;
    }
    
    match /patient_interactions/{interactionId} {
      // Server-only access; enforce region checks in server actions
      allow read, write: if false;
    }
    
    match /patient_documents/{documentId} {
      // Server-only access; enforce region checks in server actions
      allow read, write: if false;
    }

    match /patient_intake_conversions/{lockId} {
      // Idempotency locks for consent-to-patient conversion; server-only via Admin SDK
      allow read, write: if false;
    }

    match /program_reports/{reportId} {
      // Only admins can read and write program reports
      allow read, write: if isAdmin();
    }
  }
}
